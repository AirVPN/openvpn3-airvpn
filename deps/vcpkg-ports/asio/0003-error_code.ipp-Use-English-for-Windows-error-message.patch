From 00e7dfcffe8f005761b4703e4f8c57f09d3a991c Mon Sep 17 00:00:00 2001
From: Lev Stipakov <lev@openvpn.net>
Date: Mon, 29 Apr 2019 10:26:13 +0300
Subject: [PATCH 3/6] error_code.ipp: Use English for Windows error messages

FormatMessageA doesn't work well with non-ASCII chars
so make it return error message in English.

Signed-off-by: Lev Stipakov <lev@openvpn.net>
Signed-off-by: Frank Lichtenheld <frank@lichtenheld.com>
---
 include/asio/impl/error_code.ipp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/asio/impl/error_code.ipp b/include/asio/impl/error_code.ipp
index 5efdc1c32..f752f0d4b 100644
--- a/include/asio/impl/error_code.ipp
+++ b/include/asio/impl/error_code.ipp
@@ -88,7 +88,7 @@ public:
     DWORD length = ::FormatMessageA(FORMAT_MESSAGE_ALLOCATE_BUFFER
         | FORMAT_MESSAGE_FROM_SYSTEM
         | FORMAT_MESSAGE_IGNORE_INSERTS, 0, value,
-        MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT), (char*)&msg, 0, 0);
+        MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US), (char*)&msg, 0, 0);
     detail::local_free_on_block_exit local_free_obj(msg);
     if (length && msg[length - 1] == '\n')
       msg[--length] = '\0';
-- 
